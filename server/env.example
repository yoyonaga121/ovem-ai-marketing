# OVEM B3 环境变量参考（复制为 shell 环境或服务管理器配置；本项目不自动读取 .env）
OVEM_PORT=4318
OVEM_HOST=127.0.0.1
OVEM_DB=server/ovem.db
OVEM_SECRET=请替换为至少32字节随机串
OVEM_SEED_PASSWORD=ovem-demo-2026

# 火山方舟 / 豆包（也可在 05 配置中台保存，UI 配置优先）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
